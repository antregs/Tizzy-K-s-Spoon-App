# Copy to .env and fill in.
# Firebase console → Project settings → General → Your apps → Web app → SDK config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Must match REGION in backend/functions/index.js
EXPO_PUBLIC_FUNCTIONS_REGION=us-east1

# Google sign-in (Google Cloud console → APIs & Services → Credentials → OAuth client IDs)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# "true" = use local Firebase emulators (npm run serve in backend/functions)
EXPO_PUBLIC_USE_EMULATORS=false
